/build/
/build-release/
/compile_commands.json
/.venv/
.cache/

# Long-sequence canonical fixtures (regenerable via dump_canonical.py --prompt-file; ~778 MB each)
tests/canonical_long*/

# Single-layer HF oracle fixtures (regenerable via dump_hf_block_oracle.py; ~350 MB)
tests/hf_oracle/

# Repo-local scratch space (AGENTS.md): durable across power cycles, unlike
# /tmp (tmpfs). Packed smoke models, benchmark outputs, ad-hoc artifacts.
# Only .gitkeep is tracked; contents are never committed.
/temp/*
!/temp/.gitkeep
.rocprofv3/
/tools/external/
