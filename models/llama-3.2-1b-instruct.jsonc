{
    "name": "Llama-3.2-1B-Instruct",
    "max_context": 131072,
    "version": 1,
    //"$schema": null,        // ...maybe? Would be better than just a version but AFAIK the schema is to be hosted online at an URL, that's a commitment.
    "producer": "Meta AI",  // "origin" may be better? This means the trainer of the base model
    "packager": "Andy Hu",  // The final distributer (after format conversion, quantization, maybe fine-tuning, etc.) of this model, signature should be verified against the pubkey of this field.
                            // Note that this is not a full model history tree. A model can be fine-tuned several times, but we care about the one who set the baseline for model, and the one who is ultimately responsible for the intgrity of the model.
    "license": "LicenseRef-llama3",    // or "MIT" etc. This is the license declared by the packager and the packager is responsible for ensuring that the license associated with the model is legit (respecting the license of others who participated in the chain that creates *this model*).
    "license_url": "https://dev.meta.ai/llama/llama3-2/license",    // optional, unfortunately this url does not even work anymore
    "license_text": "...",      // also optional.
    
    // The producer-packager-license thing is to allow for the clear declaration of things for a model, and for them to be part of the signed description of the model. I hope that the clarity can avoid community drama instead of creating them. But ultimately the inference engine is not going to aggressively enforce the rules in the same way that a video codec is not going to enforce copyright laws.

    "chat_template": {
        "type": "jinja",
        "version": 1,
        "config": {},       // I cannot think of any custom configs for a jinja chat template, maybe I am not familiar with jinja but it seems pretty self-contained.
        "file": "chat_template.jinja",
        "offset": 0,
        "size": 12345,
        "codec": "raw",
        "hash": "..."
    },
    "tokenizer": {
        "type": "llama",      // This is now the part that I am the most unsure about. Some tokenizers have their own script.
        "version": 1,
        "config": {
            "vocab_size": 128256,
            "bos_token": "<|begin_of_text|>",
            "bos_token_id": 128000,
            "eos_token": "<|eot_id|>",
            "eos_token_ids": [
                128001,
                128008,
                128009
            ]
        },
        "file": "tokenizer.json",
        "offset": 0,
        "size": 123456,
        "codec": "raw",
        "hash": "..."
    },
    "embedder": {
        "type": "plain_embedder_bf16",
        "version": 1,
        "config": {
            "vocab_size": 128256,
            "embedding_dim": 2048
        },
        "file": "...",
        "offset": 0,
        "size": 123456,
        "codec": "raw",
        "hash": "..."
    },
    // lm_head
    "language_head": {
        "type": "plain_language_head_bf16",
        "version": 1,
        "tying": true,
        "config": {
            "vocab_size": 128256,
            "hidden_dim": 2048
        },
        "file": "...",
        "offset": 0,
        "size": 123456,
        "codec": "raw",
        "hash": "..."
    },
    "trunk": {
        "type": "rmsnorm_add_bf16",
        "version": 1,
        "config": {
            "hidden_dim": 2048,
            "epsilon": 1e-05
        },
        "file": "...",
        "offset": 0,
        "size": 123456,
        "codec": "raw",
        "hash": "..."
    },
    "block_specs": {
        "ffn": {
            "type": "dense_ffn_bf16",
            "version": 1,
            "config": {
                "io_dim": 2048,
                "intermediate_dim": 8192
            }
        },
        "attention": {
            "type": "gqa_attention_bf16",
            "version": 1,
            "config": {
                "io_dim": 2048,
                "qk_dim": 64,
                "v_dim": 64,
                "num_q_heads": 32,
                "num_kv_heads": 8,
                "rope_theta": 500000.0,
                // may also use a sub-object for rope_scaling stuff, but I don't think it is necessary
                "rope_scaling_type": "llama3",
                "rope_scaling_factor": 32.0,
                "rope_scaling_low_freq_factor": 1.0,
                "rope_scaling_high_freq_factor": 4.0,
                "original_max_position_embeddings": 8192
            }
        }
    },
    "blocks": [
        {
            "spec": "attention",
            "file": "...",
            "offset": 0,
            "size": 123456,
            "codec": "raw",
            "hash": "..."
        },
        {
            "spec": "ffn",
            "file": "...",
            "offset": 0,
            "size": 234567,
            "codec": "raw",
            "hash": "..."
        },
        {
            "spec": "attention",
            "file": "...",
            "offset": 0,
            "size": 123456,
            "codec": "raw",
            "hash": "..."
