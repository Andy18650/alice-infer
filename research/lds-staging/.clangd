CompileFlags:
  CompilationDatabase: ../../temp/lds-staging/base
  Compiler: /usr/lib/llvm-21/bin/clang++
  Add: [-std=c++20, -x, hip, --offload-arch=gfx90a, -D__HIP_PLATFORM_AMD__=1]
---
If:
  PathMatch: latency\.hip
CompileFlags:
  CompilationDatabase: ../../temp/lds-staging/latency
---
If:
  PathMatch: grid-latency\.hip
CompileFlags:
  CompilationDatabase: ../../temp/lds-staging/grid-latency
---
If:
  PathMatch: wait-bandwidth\.hip
CompileFlags:
  CompilationDatabase: ../../temp/lds-staging/windows/template
---
If:
  PathMatch: vgpr-ring\.hip
CompileFlags:
  CompilationDatabase: ../../temp/lds-staging/vgpr-ring
---
If:
  PathMatch: grid-vgpr\.hip
CompileFlags:
  CompilationDatabase: ../../temp/lds-staging/grid-vgpr
