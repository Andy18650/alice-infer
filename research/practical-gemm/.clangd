CompileFlags:
  CompilationDatabase: ../../temp/practical-gemm/rowmajor-a-v2/rowmajor
  Compiler: /usr/lib/llvm-21/bin/clang++
  Add: [-std=c++20, -x, hip, --offload-arch=gfx90a, -D__HIP_PLATFORM_AMD__=1]
---
If:
  PathMatch: rowmajor_kernel\.hpp
CompileFlags:
  Add: [-include, hip/hip_runtime.h, -include, compute.hpp]
---
If:
  PathMatch: (common_probe\.hip|common_gpu\.hpp|common_host\.hpp)
CompileFlags:
  CompilationDatabase: ../../temp/practical-gemm/common-b-v1/block128
